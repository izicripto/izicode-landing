rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function hasRole(role) {
      let userData = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return isAuthenticated() && userData != null && userData.role == role;
    }
    
    function isTeacher() {
      return hasRole('teacher');
    }
    
    function isSchoolTeacher() {
      return hasRole('school_admin') || hasRole('teacher');
    }
    
    function isStudent() {
      return hasRole('student');
    }
    
    function isSchoolAdmin() {
      return hasRole('school_admin');
    }
    
    function isAdmin() {
      return hasRole('admin');
    }
    
    // Users collection
    match /users/{userId} {
      // Cross-user reads are scoped to the same school so classmates/
      // colleagues can appear in rosters and leaderboards, without letting
      // any signed-in account dump every user's name/email/role/plan.
      function sameSchool() {
        let me = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
        return isAuthenticated() &&
               'schoolId' in resource.data && resource.data.schoolId != null &&
               'schoolId' in me && me.schoolId == resource.data.schoolId;
      }

      allow read: if isOwner(userId) || isAdmin() || sameSchool();

      // A user may only self-assign non-privileged roles/plans.
      // Promotion to 'admin', 'professor-pro' or a paid subscription plan
      // must go through an admin or a trusted Cloud Function (Admin SDK
      // writes bypass these rules entirely, so that path is unaffected).
      function isSafeSelfRole() {
        return !('role' in request.resource.data) ||
               (request.resource.data.role != 'admin' && request.resource.data.role != 'professor-pro');
      }

      function isSafeSelfSubscription() {
        return !('subscription' in request.resource.data) ||
               !('plan' in request.resource.data.subscription) ||
               request.resource.data.subscription.plan == 'free';
      }

      // Plano gratuito do professor autônomo: até 3 planos de aula/roteiros
      // de IA salvos (contador vitalício simples). Virar 'pro' (feito por
      // admin/Cloud Function, nunca pelo próprio usuário) libera uso ilimitado.
      // O contador só pode subir de 1 em 1 e nunca é gravável para baixo pelo
      // próprio usuário, evitando reset manual do limite.
      function currentUsage() {
        return ('subscription' in resource.data && 'projectsCreated' in resource.data.subscription)
          ? resource.data.subscription.projectsCreated : 0;
      }

      function isSafeUsageIncrement() {
        let before = currentUsage();
        let after = ('subscription' in request.resource.data && 'projectsCreated' in request.resource.data.subscription)
          ? request.resource.data.subscription.projectsCreated : before;
        return after == before || after == before + 1;
      }

      allow create: if isAuthenticated() && request.auth.uid == userId &&
                       isSafeSelfRole() && isSafeSelfSubscription();

      allow update: if isAuthenticated() && request.auth.uid == userId &&
                       (
                         isAdmin() ||
                         (
                           (isSafeSelfRole() || request.resource.data.role == resource.data.role) &&
                           (isSafeSelfSubscription() ||
                             (('subscription' in request.resource.data) &&
                              request.resource.data.subscription.plan == resource.data.subscription.plan)) &&
                           isSafeUsageIncrement()
                         )
                       );

      allow delete: if isAdmin();
      
      // Projetos do usuário
      match /projects/{projectId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // Progresso do usuário na Academia do Professor (courses-data.js)
      match /courseProgress/{courseId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // Perfis de crianças vinculados à conta do responsável (LGPD: o
      // titular dos dados é o responsável, que cria e controla o acesso;
      // a criança não tem login/credenciais próprias, apenas um "perfil"
      // dentro da sessão do responsável, protegido pelas mesmas regras de
      // dono de conta).
      match /children/{childId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }
    
    // Schools collection
    // 'plan' controla o acesso comercial: 'demo' é a demonstração criada a
    // partir do código de acesso escola (sem gerenciamento de turmas real),
    // 'active' é liberado após a contratação (cobrança por professores +
    // alunos). Só admin/Cloud Function promove demo -> active.
    function isSchoolPlanActive(schoolId) {
      let school = get(/databases/$(database)/documents/schools/$(schoolId)).data;
      return school != null && school.plan == 'active';
    }

    match /schools/{schoolId} {
      allow read: if isAuthenticated();
      allow create: if isSchoolAdmin() || isAdmin();
      allow update: if (isSchoolAdmin() && request.auth.uid == resource.data.adminId &&
                          request.resource.data.plan == resource.data.plan) || isAdmin();
    }

    // Classes collection (gerenciamento de turmas)
    // Criação/edição de turmas reais exige plano 'active' da escola; o
    // acesso 'demo' (via código de demonstração) só permite leitura, para
    // que a escola experimente a plataforma antes de contratar.
    match /classes/{classId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() ||
                       ((isSchoolTeacher() || isSchoolAdmin()) &&
                        isSchoolPlanActive(request.resource.data.schoolId));
      allow update, delete: if isAdmin() ||
                               (isSchoolAdmin() && isSchoolPlanActive(resource.data.schoolId)) ||
                               (isTeacher() && resource.data.teacherId == request.auth.uid &&
                                isSchoolPlanActive(resource.data.schoolId));
    }
    
    // Challenges collection
    match /challenges/{challengeId} {
      allow read: if isAuthenticated() && resource.data.isPublic == true;
      allow read: if isAuthenticated() && 
                     resource.data.createdBy == request.auth.uid;
      allow create: if isTeacher() && 
                       request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isAuthenticated() && 
                               resource.data.createdBy == request.auth.uid;
      allow read, write: if isAdmin();
    }
    
    // Student Progress collection
    match /studentProgress/{progressId} {
      allow read, update: if isStudent() && 
                             resource.data.studentId == request.auth.uid;
      allow read: if isTeacher() || isSchoolAdmin();
      allow create: if isAuthenticated() && request.resource.data.studentId == request.auth.uid;
      allow read, write: if isAdmin();
    }
    
    // Badges collection
    match /badges/{badgeId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // User Badges collection
    match /userBadges/{userBadgeId} {
      allow read: if isAuthenticated() && 
                     resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read, write: if isAdmin();
    }
    
    // Library collection (Community Projects)
    // Leitura pública, escrita validada anti-spam: exige schema mínimo,
    // autoria vinculada ao próprio uid e trava de tamanho.
    function isValidLibraryProject() {
      let d = request.resource.data;
      return d.keys().hasAll(['title', 'content', 'authorId'])
        && d.title is string && d.title.size() > 3 && d.title.size() < 200
        && d.content is string && d.content.size() > 10 && d.content.size() < 50000
        && d.authorId == request.auth.uid;
    }
    match /library/{projectId} {
      allow read: if true; // Public read
      allow create: if isAuthenticated() && isValidLibraryProject();
      allow update: if isAuthenticated() && isValidLibraryProject()
        && (isOwner(resource.data.authorId) || isAdmin());
      allow delete: if isOwner(resource.data.authorId) || isAdmin();
    }
    
    // Learning Materials collection
    
    // Material Progress
    match /materialProgress/{progressId} {
      allow read, update: if isAuthenticated() && 
                             resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() &&
                      request.resource.data.userId == request.auth.uid;
    }

    // Leads (Contact Form) - Protection against spam
    match /leads/{leadId} {
      // Schema mínimo + limites anti-spam. Rate-limit real deve ser
      // reforçado via App Check / Cloud Function.
      allow create: if request.resource.data.name is string
                       && request.resource.data.name.size() > 1
                       && request.resource.data.name.size() < 100
                       && request.resource.data.email is string
                       && request.resource.data.email.size() > 5
                       && request.resource.data.email.size() < 254;
      // Only admins can read leads
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }
  }
}
