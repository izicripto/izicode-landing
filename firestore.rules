rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function hasRole(role) {
      let userData = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return isAuthenticated() && userData != null && userData.role == role;
    }
    
    function isTeacher() {
      return hasRole('teacher');
    }
    
    function isSchoolTeacher() {
      return hasRole('school_admin') || hasRole('teacher');
    }
    
    function isStudent() {
      return hasRole('student');
    }
    
    function isSchoolAdmin() {
      return hasRole('school_admin');
    }
    
    // Dono da plataforma: uma única conta, verificada pelo e-mail que vem
    // dentro do token de autenticação. Esse campo é assinado pelo Firebase
    // Auth, então o navegador não tem como forjá-lo — diferente do papel
    // gravado no documento do usuário, que é dado comum.
    //
    // Ancorar aqui também evita o pior cenário de painel administrativo:
    // alguém alterar o próprio documento e se promover. E garante que o
    // dono nunca se tranque para fora por um doc mal gravado.
    function isPlatformOwner() {
      return isAuthenticated() && request.auth.token.email == 'izicripto@gmail.com';
    }

    function isAdmin() {
      return isPlatformOwner() || hasRole('admin');
    }

    // ---- vínculos com escola e turma ----
    // Papel no documento do usuário é dado comum (a pessoa escolhe no onboarding), então
    // "ser professor" NÃO dá acesso a nada de uma escola. O acesso vem do vínculo:
    // ser o professor da turma, o gestor (adminId) da escola ou membro dela (schoolId).
    function meuSchoolId() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('schoolId', null)
        : null;
    }

    function membroDaEscola(schoolId) {
      return isAuthenticated() && schoolId != null && meuSchoolId() == schoolId;
    }

    function gestorDaEscola(schoolId) {
      return isAuthenticated() && schoolId != null
        && exists(/databases/$(database)/documents/schools/$(schoolId))
        && get(/databases/$(database)/documents/schools/$(schoolId)).data.adminId == request.auth.uid;
    }

    function turma(classId) {
      return get(/databases/$(database)/documents/classes/$(classId)).data;
    }

    function professorDaTurma(classId) {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/classes/$(classId))
        && turma(classId).get('teacherId', null) == request.auth.uid;
    }

    function cuidaDaTurma(classId) {
      return professorDaTurma(classId)
        || (exists(/databases/$(database)/documents/classes/$(classId)) && gestorDaEscola(turma(classId).get('schoolId', null)));
    }

    // Uid de aluno vem do login por palavra secreta: "student_{classId}_{studentId}".
    function turmaDoAluno(studentUid) {
      return studentUid is string && studentUid.matches('student_[^_]+_.+') ? studentUid.split('_')[1] : '';
    }
    
    // Users collection
    match /users/{userId} {
      // Cross-user reads are scoped to the same school so classmates/
      // colleagues can appear in rosters and leaderboards, without letting
      // any signed-in account dump every user's name/email/role/plan.
      function sameSchool() {
        let me = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
        return isAuthenticated() &&
               'schoolId' in resource.data && resource.data.schoolId != null &&
               'schoolId' in me && me.schoolId == resource.data.schoolId;
      }

      allow read: if isOwner(userId) || isAdmin() || sameSchool();

      // Papéis que a pessoa pode atribuir a si mesma.
      //
      // Lista de PERMISSÃO, e não de bloqueio. A versão anterior barrava
      // 'admin' e 'professor-pro' e liberava o resto — e esqueceu 'dev'.
      // Como 'dev' conta como PRO tanto no app quanto na function aiChat,
      // qualquer conta gratuita podia se promover e passar a usar a IA na
      // chave paga da Izicode, sem limite.
      //
      // Com lista de permissão o erro se inverte: um papel novo nasce
      // bloqueado até alguém decidir liberá-lo, em vez de nascer liberado
      // até alguém lembrar de bloqueá-lo.
      //
      // Estes são os papéis que o onboarding atribui de fato. Promoção a
      // 'admin', 'dev', 'professor-pro' ou plano pago passa por um admin
      // ou por uma Cloud Function — o Admin SDK ignora estas regras, então
      // esse caminho continua funcionando.
      function isSafeSelfRole() {
        return !('role' in request.resource.data) ||
               request.resource.data.role in
                 ['student', 'parent', 'teacher', 'freelance_teacher', 'school_admin'];
      }

      function isSafeSelfSubscription() {
        return !('subscription' in request.resource.data) ||
               !('plan' in request.resource.data.subscription) ||
               request.resource.data.subscription.plan == 'free';
      }

      // Plano gratuito do professor autônomo: até 3 planos de aula/roteiros
      // de IA salvos (contador vitalício simples). Virar 'pro' (feito por
      // admin/Cloud Function, nunca pelo próprio usuário) libera uso ilimitado.
      // O contador só pode subir de 1 em 1 e nunca é gravável para baixo pelo
      // próprio usuário, evitando reset manual do limite.
      function currentUsage() {
        return ('subscription' in resource.data && 'projectsCreated' in resource.data.subscription)
          ? resource.data.subscription.projectsCreated : 0;
      }

      function isSafeUsageIncrement() {
        let before = currentUsage();
        let after = ('subscription' in request.resource.data && 'projectsCreated' in request.resource.data.subscription)
          ? request.resource.data.subscription.projectsCreated : before;
        return after == before || after == before + 1;
      }

      // Vincular-se a uma escola exige o código dela (índice codigosEscola), do tipo
      // certo para o papel: código de aluno para aluno, de professor para professor.
      // Antes qualquer conta gravava o schoolId de qualquer escola e passava a ler os
      // dados das pessoas de lá.
      function vinculoDeEscolaValido() {
        let novo = request.resource.data.get('schoolId', null);
        let antigo = resource == null ? null : resource.data.get('schoolId', null);
        let c = request.resource.data.get('codigoEscola', '');
        return novo == null || novo == antigo || (
          c is string && c.size() > 0
          && exists(/databases/$(database)/documents/codigosEscola/$(c))
          && get(/databases/$(database)/documents/codigosEscola/$(c)).data.schoolId == novo
          && (
            (get(/databases/$(database)/documents/codigosEscola/$(c)).data.tipo == 'student' && request.resource.data.get('role', '') == 'student') ||
            (get(/databases/$(database)/documents/codigosEscola/$(c)).data.tipo == 'teacher' && request.resource.data.get('role', '') in ['teacher', 'freelance_teacher'])
          )
        );
      }

      allow create: if isAuthenticated() && request.auth.uid == userId &&
                       isSafeSelfRole() && isSafeSelfSubscription() && vinculoDeEscolaValido();

      // Duas portas distintas, de propósito:
      //
      // 1. O admin edita qualquer usuário — é o que permite promover a
      //    PRO, mudar papel e vincular escola pelo painel de gestão. Antes
      //    a condição exigia `request.auth.uid == userId` para todo mundo,
      //    então nem o admin conseguia alterar a conta de outra pessoa.
      // 2. O usuário comum edita só o próprio documento, e ainda assim
      //    sem conseguir se promover a admin/professor-pro nem se dar um
      //    plano pago (essas mudanças passam por admin ou Cloud Function).
      allow update: if isAdmin() ||
                       (
                         isAuthenticated() && request.auth.uid == userId &&
                         (isSafeSelfRole() || request.resource.data.role == resource.data.role) &&
                         (isSafeSelfSubscription() ||
                           (('subscription' in request.resource.data) &&
                            request.resource.data.subscription.plan == resource.data.subscription.plan)) &&
                         isSafeUsageIncrement() &&
                         vinculoDeEscolaValido()
                       );

      allow delete: if isAdmin();
      
      // Projetos do usuário
      match /projects/{projectId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // Progresso do usuário na Academia do Professor (courses-data.js)
      match /courseProgress/{courseId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // Perfis de crianças vinculados à conta do responsável (LGPD: o
      // titular dos dados é o responsável, que cria e controla o acesso;
      // a criança não tem login/credenciais próprias, apenas um "perfil"
      // dentro da sessão do responsável, protegido pelas mesmas regras de
      // dono de conta).
      match /children/{childId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }
    
    // Schools collection
    // 'plan' controla o acesso comercial: 'demo' é a demonstração criada a
    // partir do código de acesso escola (sem gerenciamento de turmas real),
    // 'active' é liberado após a contratação (cobrança por professores +
    // alunos). Só admin/Cloud Function promove demo -> active.
    function isSchoolPlanActive(schoolId) {
      let school = get(/databases/$(database)/documents/schools/$(schoolId)).data;
      return school != null && school.plan == 'active';
    }

    // Índice código → escola. Quem tem o código confere; ninguém lista todos.
    // Mantido pelo dono da plataforma (painel de escolas sincroniza com os códigos).
    match /codigosEscola/{codigo} {
      allow get: if isAuthenticated();
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // Escola: só quem é dela (membro ou gestor) e o dono da plataforma. Antes qualquer
    // conta listava todas as escolas com os códigos de aluno e de professor.
    match /schools/{schoolId} {
      allow read: if isAdmin() || membroDaEscola(schoolId) || resource.data.get('adminId', null) == request.auth.uid;
      allow create: if isSchoolAdmin() || isAdmin();
      allow update: if (isSchoolAdmin() && request.auth.uid == resource.data.adminId &&
                          request.resource.data.plan == resource.data.plan) || isAdmin();
    }

    // Classes collection (gerenciamento de turmas)
    // Criação/edição de turmas reais exige plano 'active' da escola; o
    // acesso 'demo' (via código de demonstração) só permite leitura, para
    // que a escola experimente a plataforma antes de contratar.
    // Alunos de uma turma. O documento guarda a palavra secreta da criança,
    // e regra de segurança não esconde campo — quem pode ler o documento lê
    // a senha inteira. Por isso nenhum aluno lê esta coleção: a tela de
    // entrada recebe nome e avatar pela Cloud Function lookupClass, que
    // devolve só isso, e a conferência da palavra acontece em studentLogin.
    // Antes: qualquer conta que se declarasse 'teacher' lia e trocava a palavra secreta
    // de todas as crianças de todas as turmas.
    match /classes/{classId}/students/{studentId} {
      allow read, write: if isAdmin() || cuidaDaTurma(classId);
    }

    match /classes/{classId} {
      // Turma: professor dela, gente da mesma escola e o aluno logado nela (token).
      allow read: if isAdmin()
        || resource.data.get('teacherId', null) == request.auth.uid
        || membroDaEscola(resource.data.get('schoolId', null))
        || gestorDaEscola(resource.data.get('schoolId', null))
        || (isAuthenticated() && request.auth.token.get('classId', '') == classId);
      allow create: if isAdmin() ||
                       ((isSchoolTeacher() || isSchoolAdmin()) &&
                        (membroDaEscola(request.resource.data.schoolId) || gestorDaEscola(request.resource.data.schoolId)) &&
                        isSchoolPlanActive(request.resource.data.schoolId));
      allow update, delete: if isAdmin() ||
                               (gestorDaEscola(resource.data.schoolId) && isSchoolPlanActive(resource.data.schoolId)) ||
                               (isTeacher() && resource.data.teacherId == request.auth.uid &&
                                isSchoolPlanActive(resource.data.schoolId));
    }
    
    // Challenges collection
    match /challenges/{challengeId} {
      allow read: if isAuthenticated() && resource.data.isPublic == true;
      allow read: if isAuthenticated() && 
                     resource.data.createdBy == request.auth.uid;
      allow create: if isTeacher() && 
                       request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isAuthenticated() && 
                               resource.data.createdBy == request.auth.uid;
      allow read, write: if isAdmin();
    }
    
    // Student Progress collection
    match /studentProgress/{progressId} {
      allow read, update: if isStudent() && 
                             resource.data.studentId == request.auth.uid;
      // Professor/gestor só da turma do aluno (o uid do aluno carrega a turma).
      allow read: if isAuthenticated() && turmaDoAluno(resource.data.studentId) != ''
        && cuidaDaTurma(turmaDoAluno(resource.data.studentId));
      allow create: if isAuthenticated() && request.resource.data.studentId == request.auth.uid;
      allow read, write: if isAdmin();
    }
    
    // Badges collection
    match /badges/{badgeId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // User Badges collection
    match /userBadges/{userBadgeId} {
      allow read: if isAuthenticated() && 
                     resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read, write: if isAdmin();
    }
    
    // Library collection (Community Projects)
    // Leitura pública, escrita validada anti-spam: exige schema mínimo,
    // autoria vinculada ao próprio uid e trava de tamanho.
    function isValidLibraryProject() {
      let d = request.resource.data;
      return d.keys().hasAll(['title', 'content', 'authorId'])
        && d.title is string && d.title.size() > 3 && d.title.size() < 200
        && d.content is string && d.content.size() > 10 && d.content.size() < 50000
        && d.authorId == request.auth.uid;
    }
    match /library/{projectId} {
      allow read: if true; // Public read
      allow create: if isAuthenticated() && isValidLibraryProject();
      allow update: if isAuthenticated() && isValidLibraryProject()
        && (isOwner(resource.data.authorId) || isAdmin());
      allow delete: if isOwner(resource.data.authorId) || isAdmin();
    }
    
    // Learning Materials collection
    
    // Material Progress
    match /materialProgress/{progressId} {
      allow read, update: if isAuthenticated() && 
                             resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() &&
                      request.resource.data.userId == request.auth.uid;
    }

    // Pagamentos. Escritos SÓ pelas Cloud Functions (que usam o Admin SDK e
    // passam por cima destas regras) — deixar o navegador escrever aqui
    // seria deixar qualquer pessoa marcar o próprio pagamento como pago e
    // liberar o plano sem pagar nada. O cliente só lê, para a tela poder
    // acompanhar o status da própria compra.
    // Cupons de desconto. Só o admin lê e escreve: liberar leitura deixaria
    // qualquer conta listar todos os códigos. Quem compra valida o cupom pela
    // function validarCupom, e o desconto é aplicado no servidor no checkout.
    // O contador 'usos' é incrementado pelo servidor ao confirmar o pagamento.
    match /coupons/{codigo} {
      allow read, write: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    // Leads (Contact Form) - Protection against spam
    match /leads/{leadId} {
      // Schema mínimo + limites anti-spam. Rate-limit real deve ser
      // reforçado via App Check / Cloud Function.
      allow create: if request.resource.data.name is string
                       && request.resource.data.name.size() > 1
                       && request.resource.data.name.size() < 100
                       && request.resource.data.email is string
                       && request.resource.data.email.size() > 5
                       && request.resource.data.email.size() < 254;
      // Only admins can read leads
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }
  }
}
