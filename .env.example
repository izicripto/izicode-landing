# 🔐 Configuração de Variáveis de Ambiente
# Copie para .env (nunca commitar o .env real). Valores abaixo são PLACEHOLDERS.

## Firebase Configuration (Client-side - PÚBLICO, restrito por domínio no Console)
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY_HERE
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

## Telegram Bot (Server-side / scripts - PRIVADO, nunca commitar)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
TELEGRAM_CONTENT_FILE=./docs/TELEGRAM_BOT_CONTENT.md

## Gemini IA pessoal (opcional, client-side via Assistente IA)
# GEMINI_API_KEY configurada via Firebase Functions (functions.config().gemini.key)
# ou chave pessoal do usuário em localStorage 'gemini_api_key'. Não colocar aqui.

## Hotmart Configuration (Server-side - PRIVADO)
HOTMART_CLIENT_ID=your_client_id_here
HOTMART_CLIENT_SECRET=your_client_secret_here
HOTMART_BASIC_AUTH=your_basic_auth_here

## Application Settings
NODE_ENV=development
PORT=3000
